# Copy to .env and fill in what you need. Every block is optional: a missing
# key switches that feature off and says so on boot, rather than stopping the
# server. `bun dev` prints which are on.

# --- Where the browser reaches the site ------------------------------------
# Stripe sends people back here after checkout. Must match the address you
# actually browse to, including port.
APP_URL=http://localhost:3000

# --- Keep-alive cron --------------------------------------------------------
# Free hosts idle a service out after a quiet spell (Render: ~15 minutes). The
# API pings its own public URL every 10 minutes so that window is never reached.
#
# On Render this needs nothing: RENDER_EXTERNAL_URL is injected automatically.
# Elsewhere, set the public address by hand. It must be the public URL, not
# localhost — only requests through the host's proxy count as activity.
#
# Off in development regardless. Set KEEPALIVE=false to disable in production.
# KEEPALIVE_URL=https://api.ouratlas.co.in
# KEEPALIVE_INTERVAL_MINUTES=10
# KEEPALIVE=false

# --- Supabase: accounts, Google sign-in, waitlist ---------------------------
# Project settings -> API. The URL and anon key are duplicated under
# BUN_PUBLIC_* because only that prefix is inlined into the browser bundle.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
BUN_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
BUN_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Bypasses row-level security. Server only — never give this the BUN_PUBLIC_
# prefix, or it ends up in the bundle every visitor downloads.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe: subscriptions --------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...

# Price ids (not product ids) for the two paid plans, from Stripe -> Products.
STRIPE_PRICE_TRAVELLER=price_...
STRIPE_PRICE_CARTOGRAPHER=price_...

# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# A different secret is issued for the deployed endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Vercel Web Analytics: the visitor counter in the nav --------------------
# Read server-side only. The token reaches your whole Vercel account, so it must
# never carry the BUN_PUBLIC_ prefix — the API queries Vercel and hands the
# browser nothing but a number.
#
# Token:      Vercel -> Account Settings -> Tokens
# Project ID: Project -> Settings -> General ("Project ID")
# Team ID:    only for team-owned projects; omit for a personal account.
#
# Unset, the counter is simply hidden rather than showing an invented figure.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...

# --- Payments: either provider ------------------------------------------------
# Dodo Payments is a merchant of record — it sells on our behalf, handles the
# tax and settles to us, which is what makes it work from India where a direct
# Stripe account cannot charge. Stripe is kept for the day that changes.
#
# Set one. With both, Dodo wins unless BILLING_PROVIDER says otherwise; naming
# a provider with no keys switches billing off rather than silently using the
# other one. Only one may be live at a time — two processors is two ledgers.
#
# The boot log names the provider and the mode actually in use.

# BILLING_PROVIDER=dodo         # or "stripe"; omit to pick by whichever is set

DODO_API_KEY=
DODO_WEBHOOK_KEY=
# DODO_MODE=live                # anything else means test mode
# Product ids from the Dodo dashboard. Dodo has no price objects: the product
# carries its own price, so one product per plan.
DODO_PRODUCT_TRAVELLER=pdt_...
DODO_PRODUCT_CARTOGRAPHER=pdt_...

# --- The copy desk: either provider ------------------------------------------
# OpenAI or Anthropic will do. Set one key. With both, OpenAI wins unless
# POLISH_PROVIDER says otherwise; naming a provider with no key switches the
# copy desk off rather than silently using the other one.
#
# The boot log names the provider and model actually in use.

# POLISH_PROVIDER=openai        # or "anthropic"; omit to pick by whichever key exists

OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1          # default; model names move faster than this file
# --- The editor: the AI art director that makes up an issue from the photos ---
# Claude Opus by default when ANTHROPIC_API_KEY is set; OpenAI otherwise.
# EDITOR_PROVIDER=anthropic             # or "openai"; a named provider without its key is off
# ANTHROPIC_EDITOR_MODEL=claude-opus-5  # default
# OPENAI_EDITOR_MODEL=gpt-5.6-luna      # used only with EDITOR_PROVIDER=openai

# The Speak tab's transcription uses the same OpenAI key, whichever provider
# the copy desk is on. It is open to every visitor for now, signed in or not
# (VOICE_NEEDS_SIGN_IN in src/types/index.ts).
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe   # default; gpt-4o-mini-transcribe costs half
# OPENAI_TRANSCRIBE_LANGUAGE=en               # default; "hi" for Hindi, "auto" to let the model guess

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# Only for identity-linked keys; ordinary keys reject this header.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# --- Export limits -----------------------------------------------------------
# How many issues a free (Wanderer) account may export in a calendar month.
# Unset, zero or unparseable means no limit at all, which is the default: a cap
# that appears because of a typo would turn readers away silently, so switching
# it on has to be deliberate. Paid plans are never counted.
#
# The boot log says which state it is in.

# EXPORT_LIMIT_FREE=3

# --- Checkout, while the merchant account is in review --------------------------
# The paid plan buttons are disabled unless this is exactly "on", because Dodo
# has not enabled payment processing yet and a card cannot go through. Set it to
# exercise checkout against Dodo's test mode locally; leave it unset everywhere
# else until the account is approved.
#
# Inlined into the bundle at build time, so it is a property of the build rather
# than something a visitor can set. Rebuild after changing it.

# BUN_PUBLIC_CHECKOUT=on
